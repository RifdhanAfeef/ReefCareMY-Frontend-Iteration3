# Copy this file to .env.local to override the deployed backend below
# (e.g. to point at a local FastAPI instance during backend development).
NEXT_PUBLIC_API_BASE_URL=https://reefcare-backend.vercel.app

# Epic 9 dive planning data: "sample" (offline prototype fixtures) or "api" (backend planning routes).
# /plan-a-dive?preview=1 always uses sample data.
NEXT_PUBLIC_E9_DATA_SOURCE=sample
